      "name": "3. CRUD e exclusao logica",
      "item": [
        {
          "name": "3.0 GET /api/frota/enums - catalogo dos dropdowns",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const c = pm.response.json();",
                  "",
                  "pm.test('Traz as tres listas', function () {",
                  "    pm.expect(c).to.have.all.keys('tipos', 'modelos', 'status');",
                  "});",
                  "",
                  "pm.test('Quantidade de opcoes por enum', function () {",
                  "    pm.expect(c.tipos).to.have.lengthOf(3);",
                  "    pm.expect(c.modelos).to.have.lengthOf(4);",
                  "    pm.expect(c.status).to.have.lengthOf(3);",
                  "});",
                  "",
                  "pm.test('Cada opcao tem valor e descricao', function () {",
                  "    [].concat(c.tipos, c.modelos, c.status).forEach(function (o) {",
                  "        pm.expect(o).to.have.property('valor');",
                  "        pm.expect(o).to.have.property('descricao');",
                  "    });",
                  "});",
                  "",
                  "pm.test('Carroceria usa MARCOPOLO (typo corrigido)', function () {",
                  "    const valores = c.modelos.map(function (o) { return o.valor; });",
                  "    pm.expect(valores).to.include('MARCOPOLO');",
                  "    pm.expect(valores).to.not.include('MARCOPOLLO');",
                  "});",
                  "",
                  "pm.test('Descricoes legiveis para o dropdown', function () {",
                  "    const porValor = {};",
                  "    [].concat(c.tipos, c.modelos, c.status).forEach(function (o) { porValor[o.valor] = o.descricao; });",
                  "    pm.expect(porValor['IRIZAR_BRASIL']).to.eql('Irizar Brasil');",
                  "    pm.expect(porValor['CONVENCIONAL']).to.eql('Convencional');",
                  "    pm.expect(porValor['MARCOPOLO']).to.eql('Marcopolo');",
                  "});"
                ]
              }
            }
          ],
