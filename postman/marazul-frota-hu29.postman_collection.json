        {
          "name": "3.1 POST cadastra veiculo sem status -> 201 e ATIVO",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Placa e prefixo sorteados para a collection ser re-executavel.",
                  "const LETRAS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';",
                  "const letra = () => LETRAS[Math.floor(Math.random() * LETRAS.length)];",
                  "const digito = () => String(Math.floor(Math.random() * 10));",
                  "",
                  "// Formato Mercosul: AAA0A00",
                  "const placa = letra() + letra() + letra() + digito() + letra() + digito() + digito();",
                  "",
                  "pm.collectionVariables.set('placa', placa);",
                  "pm.collectionVariables.set('placaMinuscula', placa.toLowerCase());",
                  "pm.collectionVariables.set('prefixo', String(1000 + Math.floor(Math.random() * 9000)));",
                  "",
                  "// Mesma placa escrita com hifen, para provar a normalizacao.",
                  "pm.collectionVariables.set('placaComHifen', placa.slice(0, 3) + '-' + placa.slice(3));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const v = pm.response.json();",
                  "",
                  "pm.test('Status ATIVO atribuido automaticamente quando nao informado', function () {",
                  "    pm.expect(v.status).to.eql('ATIVO');",
                  "});",
                  "",
                  "pm.test('dataVistoria e opcional e permanece nula', function () {",
                  "    pm.expect(v.dataVistoria).to.be.null;",
                  "});",
                  "",
                  "pm.test('Placa persistida em caixa alta', function () {",
                  "    pm.expect(v.placa).to.eql(pm.collectionVariables.get('placa'));",
                  "});",
                  "",
                  "pm.collectionVariables.set('veiculoId', v.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prefixo\": \"{{prefixo}}\",\n  \"placa\": \"{{placa}}\",\n  \"modelo\": \"MARCOPOLO\",\n  \"tipo\": \"LD\",\n  \"ano\": 2022,\n  \"assentos\": 46\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/frota",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "frota"
              ]
            }
          }
        },
