        {
          "name": "3.9 POST placa com hifen -> 201 e placa normalizada",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Placa no formato antigo, em caixa baixa e com hifen: aaa-1234",
                  "const LETRAS = 'abcdefghijklmnopqrstuvwxyz';",
                  "const letra = () => LETRAS[Math.floor(Math.random() * LETRAS.length)];",
